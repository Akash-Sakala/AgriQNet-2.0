# ─────────────────────────────────────────────────────────────────────────────
# AgriQNet platform – single configuration file for every service.
# Copy to .env (the launcher does this automatically on first run) and fill in keys.
# ─────────────────────────────────────────────────────────────────────────────

# --- AI keys (server-side only; never shipped to the browser) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# AgriRAG answers with Groq; falls back to Gemini if Groq is missing/fails
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- Farmer Library (AgriRAG) ---
# Embeddings: multilingual-e5-base (default) | intfloat/multilingual-e5-small (slow PCs) | BAAI/bge-m3 (strong PCs)
RAG_EMBED_MODEL=intfloat/multilingual-e5-base
# Reranker ("none" to switch off)
RAG_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Book covers: auto = AI art when a provider below is set, otherwise the printed cover / a photo from the PDF
COVER_AI=auto
# Gemini image generation needs a billed key, e.g. gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=
# Free Hugging Face token (huggingface.co/settings/tokens) -> FLUX.1-schnell cover art
HF_TOKEN=
LIBRARY_MAX_MB=80
# Queue the ICAR / UAS / DES starter shelf on first start, and check those sites for new reports every N days (0 = never)
LIBRARY_AUTOSEED=false
LIBRARY_CRAWL_DAYS=0
#LIBRARY_DIR=

# --- Read-aloud backup voice (used only when the phone/PC has no Kannada/Telugu/Hindi voice) ---
# Free key: https://dashboard.sarvam.ai  (Bulbul text-to-speech)
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka

# --- Weather app (browser key – OpenWeather free tier: current + 5-day) ---
VITE_OPENWEATHER_API_KEY=

# --- SMS / OTP (Twilio). SMS_MODE: auto | twilio | simulate ---
#   auto     = use Twilio when configured, otherwise (or on failure) simulate & log to the outbox
#   simulate = never send real SMS (OTP code is shown in the UI)
SMS_MODE=auto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
REQUIRE_OTP_FOR_SIGNUP=true
# Farmer pest reports are sent to nearby farmers automatically when the photo AI is at least this
# confident (or a 2nd farmer reports the same pest in the district); otherwise an officer approves.
AUTO_ALERT_CONFIDENCE=0.6
# Seconds-to-wait for one AI model before trying the next (Gemini -> Groq), in ms
AI_TIMEOUT_MS=20000
# Optional: secret for login tokens (generated automatically if empty)
AUTH_SECRET=

# --- Database ---
# Leave MONGO_URI empty to use the embedded MongoDB started by `npm start`
# (data kept in %LOCALAPPDATA%\AgriQNet\mongo-data on Windows, ~/.agriqnet/mongo-data elsewhere).
# Or point it at your own MongoDB / Atlas cluster:
#MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/agriqnet
MONGO_PORT=27017
AUTO_SEED=true

# --- Ports ---
API_PORT=5000
WEB_PORT=3000
WEATHER_PORT=5175
PEST_DETECTOR_PORT=8001
RECOMMENDER_PORT=8002
RAG_PORT=8003

# --- URLs the browser uses to open sibling apps (change if you deploy) ---
VITE_WEATHER_APP_URL=http://localhost:5175
VITE_WEB_APP_URL=http://localhost:3000

# Hosted fallback for the crop/fertilizer models if the local service is down ("none" to disable)
RECOMMENDER_FALLBACK_URL=https://agro-backend-ns2o.onrender.com
# Crop/fertilizer models: v3 = AgriQNet v3 quantum-hybrid (default), legacy = original v1 models
RECOMMENDER_MODELS=v3

# Where the venv, MongoDB data and binaries live (defaults outside OneDrive)
#AGRIQNET_HOME=
