  "mgmt_Grapes (Vitis)_0": "ಸೋಂಕು ತಗುಸಿದ ಗಿಡದ ಗೆಲ್ಲುಗಳನ್ನು ಕತ್ತರಿಸಿ ಸುಟ್ಟುಹಾಕಿ.",
  "mgmt_Grapes (Vitis)_1": "ಹಿಂಡಿಹುಳು ಮತ್ತು ಕಾಂಡಕೊರೆಯುವ ಕೀಟಗಳಿಗೆ ತೊಗಟೆ ಕೆತ್ತುವುದು ಮತ್ತು ಲೇಪಿಸುವುದು ಮಾಡಿ.",
  "mgmt_Grapes (Vitis)_2": "ಹಿಂಡಿಹುಳುಗಳ ವಿರುದ್ಧ ಕ್ರಿಪ್ಟೋಲಾಮಸ್ ಜೀವಿಗಳನ್ನು ಬಿಡಿ.",
  "mgmt_Grapes (Vitis)_3": "ಮರಸೇಬು ನುಸಿಗಳಿಗೆ ಸೂಚನೆ ಪ್ರಕಾರ ಗಂಧಕದ ಪುಡಿ ಬಳಸಿ.",
  "crop_Citrus": "ಲಿಂಬೆ / ಕಿತ್ತಳೆ",
  "mgmt_Citrus_0": "ಹುಳು ಬಿದ್ದ ಬಿದ್ದಿರುವ ಹಣ್ಣುಗಳನ್ನು ಒಟ್ಟುಗೂಡಿಸಿ ನಾಶಮಾಡಿ.",
  "mgmt_Citrus_1": "ಹಣ್ಣಿನ ನೊಣಗಳಿಗೆ ಮೆಥಿಲ್-ಯುಜೆನಾಲ್ ಬಲೆಗಳನ್ನು ಬಳಸಿ (ಹೆಕ್ಟೇರಿಗೆ 10).",
  "mgmt_Citrus_2": "ಶಲ್ಕ ಕೀಟಗಳು ಮತ್ತು ಬಿಳಿ ನೊಣಗಳಿಗೆ ತೋಟಗಾರಿಕಾ ತೈಲ ಸಿಂಪಡಿಸಿ.",
  "mgmt_Citrus_3": "ಗಾಳಿ ಆಡಲು ದಟ್ಟವಾದ ರೆಂಬೆಗಳನ್ನು ಕತ್ತರಿಸಿ.",
  "crop_Mango": "ಮಾವು",
  "mgmt_Mango_0": "ಹೂವಿನ ಗೊಂಚಲುಗಳಲ್ಲಿ ಜಿಗಿಹುಳು ಮತ್ತು ನೊಣಗಳಿವೆಯಾ ನೋಡಿ.",
  "mgmt_Mango_1": "ಹಣ್ಣು ಬಿಟ್ಟಾಗಿನಿಂದ ಕಟಾವು ಮಾಡುವವರೆಗೆ ಹಣ್ಣಿನ ನೊಣದ ಬಲೆಗಳನ್ನು ಬಳಸಿ.",
  "mgmt_Mango_2": "ಬಿದ್ದ ಹಣ್ಣುಗಳು ಮತ್ತು ಕಾಯಿಕೊರೆಯುವ ಹುಳುವಿನ ಬೀಜಗಳನ್ನು ನಾಶ ಮಾಡಿ.",
  "mgmt_Mango_3": "ತೋಟದ ನೆಲವನ್ನು ಸ್ವಚ್ಛವಾಗಿಡಿ; ಮರಗಳು ತುಂಬಾ ದಟ್ಟವಾಗಿ ಬೆಳೆಯದಂತೆ ನೋಡಿಕೊಳ್ಳಿ."
}
