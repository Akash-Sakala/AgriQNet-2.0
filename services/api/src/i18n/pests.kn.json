  "mgmt_Rice_3": "ಸ್ಥಳೀಯ ರೈತ ಸಂಪರ್ಕ ಕೇಂದ್ರದ ಸಲದಂತೆ ಮಾತ್ರ ಕೀಟನಾಶಕ ಸಿಂಪಡಿಸಿ.",
  "crop_Corn / Maize": "ಮುಕ್ಕೆಜೋಳ / ಜೋಳ",
  "mgmt_Corn / Maize_0": "ಮಣ್ಣಿನ ಕೀಟಗಳು ಮತ್ತು ಕೋಶಾವಸ್ಥೆಯನ್ನು ನಾಶ ಮಾಡಲು ಬೇಸಿಗೆಯಲ್ಲಿ ಆಳವಾಗಿ ಉಳುಮೆ ಮಾಡಿ.",
  "mgmt_Corn / Maize_1": "ಸೊಟ್ಟ ಹುಳು ಮತ್ತು ಕಾಂಡಕೊರೆಯುವ ಹುಳುಗಳಿಗೆ ಸುಣ್ಣ + ಮರಳು ಅಥವಾ ಬೇವಿನ ಹಿಂಡಿಯನ್ನು ಸುರಿಯಿರಿ.",
  "mgmt_Corn / Maize_2": "ಸೈನಿಕ ಹುಳುಗಳಿಗಾಗಿ ಫೆರೋಮೋನ್ ಬಲೆಗಳನ್ನು (ಎಕರೆಗೆ 5) ಬಳಸಿ.",
  "mgmt_Corn / Maize_3": "ದ್ವಿದಳ ಧಾನ್ಯಗಳೊಂದಿಗೆ ಬೆಳೆ ಬದಲಾವಣೆ ಮಾಡಿ; ಕಳೆಗಳನ್ನು ತೆಗೆದು ನಾಶಮಾಡಿ.",
  "crop_Wheat": "ಗೋಧಿ",
  "mgmt_Wheat_0": "ಸರಿಯಾದ ಸಮಯದಲ್ಲಿ ಬಿತ್ತನೆ ಮಾಡಿ ಮತ್ತು ಸಮತೋಲಿತ ಗೊಬ್ಬರ ಬಳಸಿ.",
  "mgmt_Wheat_1": "ಹೇನುಗಳ ವಿರುದ್ಧ ಜೀಂಡ ಹುಳುಗಳು ಮತ್ತು ಸಿರ್ಫಿಡ್ ನೊಣಗಳನ್ನು ಉತ್ತೇಜಿಸಿ.",
  "mgmt_Wheat_2": "ಮುಂಚಿತವಾಗಿ ಕೀಟಗಳನ್ನು ಗುರುತಿಸಲು ಹಳದಿ ಅಂಟು ಬಲೆಗಳನ್ನು ಬಳಸಿ.",
  "mgmt_Wheat_3": "ಬಿತ್ತನೆ ಮಾಡುವ ಮೊದಲು ಬೀಜೋಪಚಾರ ಮಾಡಿ.",
  "crop_Sugar beet / Vegetables": "ಸಕ್ಕರೆ ಗೆಡ್ಡೆ / ತರಕಾರಿಗಳು",
  "mgmt_Sugar beet / Vegetables_0": "ಹೊಲದ ಸುತ್ತಲಿರುವ ಕಳೆಗಳನ್ನು ತೆಗೆದುಹಾಕಿ.",
  "mgmt_Sugar beet / Vegetables_1": "ಮೊಟ್ಟೆಯ ಗೊಂಚಲುಗಳು ಮತ್ತು ಚಿಕ್ಕ ಹುಳುಗಳನ್ನು ಕೈಯಿಂದ ತೆಗೆದುಹಾಕಿ.",
  "mgmt_Sugar beet / Vegetables_2": "ಬೇವಿನ ಬೀಜದ ತಿರುಳಿನ ಕಷಾಯವನ್ನು (5%) ಸಿಂಪಡಿಸಿ.",
  "mgmt_Sugar beet / Vegetables_3": "ಬೇರೆ ಬೆಳೆಯನ್ನು ಬದಲಾಯಿಸಿ ಬೆಳೆಯಿರಿ.",
  "crop_Alfalfa / Pulses": "ಅಲ್ಫಾಲ್ಫಾ / ದ್ವಿದಳ ಧಾನ್ಯಗಳು",
  "mgmt_Alfalfa / Pulses_0": "ಹುಳು ತಗುಸಿದ ಮೇವನ್ನು ಬೇಗನೆ ಕೊಯ್ಲು ಮಾಡಿ.",
